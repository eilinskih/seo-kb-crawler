NODE_ENV=development
API_PORT=3000

POSTGRES_DB=seo_kb
POSTGRES_USER=seo_kb
POSTGRES_PASSWORD=seo_kb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://seo_kb:seo_kb@localhost:5432/seo_kb

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Optional self-host SERP sidecar.
# Example: docker run --rm -p 127.0.0.1:7000:7000 karust/openserp:latest serve -a 0.0.0.0 -p 7000
OPENSERP_BASE_URL=
OPENSERP_ENGINES=google,bing
OPENSERP_TIMEOUT_MS=20000
