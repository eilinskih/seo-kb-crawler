NODE_ENV=development
API_PORT=3000

POSTGRES_DB=seo_kb
POSTGRES_USER=seo_kb
POSTGRES_PASSWORD=seo_kb
POSTGRES_PORT=15432
DATABASE_URL=postgresql://seo_kb:seo_kb@localhost:15432/seo_kb

REDIS_PORT=16379
REDIS_URL=redis://localhost:16379

OPERATOR_CONSOLE_PORT=4010
OPERATOR_CONSOLE_ACCESS_TOKEN=local-operator-token

# MCP server for Codex/agent workspaces.
SEO_KB_API_BASE_URL=http://127.0.0.1:3000
SEO_KB_MCP_TIMEOUT_MS=30000

# Optional self-host SERP sidecar.
# Port 7000 is often occupied by macOS Control Center, so local smoke examples
# use 17700 on the host and 7000 inside the container.
# Example: docker run --rm -p 127.0.0.1:17700:7000 karust/openserp:latest serve -a 0.0.0.0 -p 7000
OPENSERP_BASE_URL=http://127.0.0.1:17700
OPENSERP_PORT=17700
OPENSERP_ENGINES=google,bing
OPENSERP_TIMEOUT_MS=20000

# Optional public entity enrichment provider. No API key is required.
WIKIDATA_ENABLED=true
WIKIDATA_SEARCH_ENDPOINT=https://www.wikidata.org/w/api.php
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql
WIKIDATA_LIMIT=5
WIKIDATA_TIMEOUT_MS=30000

# Local-first embedding provider.
# Install once with: ollama pull bge-m3
# When running the app outside Docker, use http://127.0.0.1:11434.
# Docker containers reach the host Ollama daemon through host.docker.internal.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_MODEL_VERSION=local
OLLAMA_EMBEDDING_DIMENSIONS=1024
